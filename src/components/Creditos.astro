      text-align:right;
      padding: 0;
    }
    img {
      width: auto;
      height: 40px;
      filter: grayscale(100%);
      transition: scale 0.3s ease;

      &:hover {
        filter: none;
        scale: 1.05;
      }
      @include tableta-land {
        height: 25px;
      }
      @include tableta {
        height: 25px;
      }
      @include cel {
        height: 30px;
      }
    }

---
import Layout from "@layouts/Layout.astro";
import Loader from "@components/Loader.astro";
import Hero from "@components/Hero.astro";
import Button from "@components/Button.astro";
import Encabezados from "@components/Encabezados.astro";
import Teaser from "@components/Teaser.astro";
import ContenedorEventosPrincipal from "@components/ContenedorEventosPrincipal.astro";

//i18n
import { getRelativeLocaleUrl } from "astro:i18n";
import ContenedorEventosSec from "@components/ContenedorEventosSec.astro";
import Timeline from "@components/Timeline.astro";
import Magazine from "@components/Magazine.astro";
import Patrocinadores from "@components/Patrocinadores.astro";
import Galeria from "@components/Galeria.astro";
import Contact from "@components/Contact.astro";
const prueba = getRelativeLocaleUrl("en", "prueba");
---

<Layout
  title="100th Anniversary of the Ess Ski School in Crans Montana"
  description="Welcome to the homepage. 2026 will be punctuated by numerous festive and sporting events to celebrate this anniversary in style."
>
  <Loader loadingText="Loading history" />
  <main>
    <Hero
      title="100 years of history… that's something to celebrate!!"
      subtitle="1926-2026"
      parrafo="2026, a special year for the Red Legends…"
      parrafo2="For 100 years, ESS Crans-Montana has navigated the decades by adapting to the changing landscape of snow sports. Today, it continues this tradition by developing year-round activities. Let yourself be surprised by our history and travel back in time through the images and anecdotes available on this page. Enjoy your visit!"
      txtBtn="Discover the program"
    />

    <Encabezados title="Timeline" subtitle="100 YEARS OF HISTORY AT A GLANCE" />

    <Timeline />
    <Encabezados title="Teaser" subtitle="100 years of history in 1 minute" />
    <div class="grid contenido">
      <Teaser
        span="REVIVE"
        title="100 YEARS"
        subtitle="adventures and passion"
        videoSrc="/100/video/hero.mp4"
      />
    </div>
    <Encabezados
      title="Events"
      subtitle="100 years of history to celebrate"
      extra="Program of festivities"
    />

    <div class="grid pantalla" id="events">
      <ContenedorEventosPrincipal />
    </div>

    <Encabezados title="Magazine" subtitle="100 years of history to remember" />
    <div class="grid contenido">
      <Magazine
        recuadro="A century of history"
        parrafo="<b>Discover</b>, through anecdotes, testimonials and highlights, the 100-year history of our Ski School in a high-end magazine."
      />
    </div>
    <Encabezados
      title="Partnerships"
      subtitle="Together to celebrate our 100 years"
    />
    <Patrocinadores />
    <div class="grid contenido">
      <Galeria />
      <Contact />
    </div>
  </main>
</Layout>
